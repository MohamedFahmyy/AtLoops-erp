{
    "name": "atloops/atloops-os",
    "description": "AT Loops OS - Complete Native PHP Internal Business Management System",
    "type": "project",
    "license": "Proprietary",
    "require": {
        "php": ">=8.3",
        "vlucas/phpdotenv": "^5.6",
        "tecnickcom/tcpdf": "^6.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    }
}
