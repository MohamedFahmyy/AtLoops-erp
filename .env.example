APP_NAME="AT Loops OS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://atloops-os.test
APP_TIMEZONE=Africa/Cairo
APP_DEFAULT_LOCALE=ar
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atloops_os
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

DB_TEST_DATABASE=atloops_os_test

SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
SESSION_COOKIE_NAME=atloops_session

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@atloops.com"
MAIL_FROM_NAME="AT Loops OS"

BACKUP_PATH=storage/backups
BACKUP_RETENTION_DAYS=30
